{
  "manifest_version": 3,
  "name": "Capture",
  "short_name": "Capture",
  "version": "1.0.0",
  "description": "Select part of any page, mark it up with arrows, text, highlights, pixelate and numbered steps, then copy or save it. Nothing is uploaded.",
  "homepage_url": "https://pageproven.com/capture-app",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Capture an area (Alt+Shift+S)",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["activeTab", "scripting", "downloads"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+S", "mac": "Alt+Shift+S" },
      "description": "Capture an area of the page"
    }
  },
  "web_accessible_resources": [
    { "resources": ["editor.html"], "matches": ["<all_urls>"] }
  ]
}
